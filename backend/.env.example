# 部署者自行设置访问令牌，不提供可复用默认凭据。
APK_API_TOKEN=
APK_BIND=127.0.0.1:7031
APK_DATA_DIR=data
APK_ADB=adb
APK_HDC=hdc
# 插件目录按需配置，内部必须是管理员认可的入口。
# APK_PLUGIN_DIR=
# 可选静态旧操作绑定文件；不配置时无别名，配置内容变更后重启宿主。
# APK_OPERATION_BINDINGS=bindings.json
# 公网部署按需配置，逗号分隔。
# APK_MCP_HOSTS=deviceforge.example.com
# APK_MCP_ORIGINS=https://deviceforge.example.com:443

{
  "id": "mirroring",
  "version": "0.1.0",
  "protocol_version": 4,
  "executable": "deviceforge-mirroring-plugin.exe",
  "args": [],
  "recovery": {"api_version":1,"operation":"runtime.recover","timeout_ms":30000},
  "artifacts": {
    "input_fields": [],
    "outputs": true
  },
  "sessions": {
    "protocol_version": 5,
    "client_context": true,
    "output_retention": "bounded_tail",
    "operations": [
      {
        "name": "open",
        "title": "实时投屏与设备控制",
        "execution": {"api_version":1,"total_timeout_ms":3600000},
        "input_schema": {
          "type":"object","additionalProperties":false,
          "properties": {
            "device_id":{"type":"string","minLength":1,"maxLength":200},
            "max_size":{"type":"integer","minimum":64,"maximum":4096},
            "max_fps":{"type":"integer","minimum":1,"maximum":60},
            "video_bit_rate":{"type":"integer","minimum":128000,"maximum":16000000},
            "audio":{"type":"boolean"},"control":{"type":"boolean"},"clipboard_autosync":{"type":"boolean"},
            "reconnect_attempts":{"type":"integer","minimum":0,"maximum":5}
          },
          "required":["device_id"]
        }
      },
      {
        "name": "open_webrtc",
        "title": "WebRTC 实时投屏与设备控制",
        "execution": {"api_version":1,"total_timeout_ms":3600000},
        "input_schema": {
          "type":"object","additionalProperties":false,
          "properties": {
            "device_id":{"type":"string","minLength":1,"maxLength":200},
            "max_size":{"type":"integer","minimum":64,"maximum":4096},
            "max_fps":{"type":"integer","minimum":1,"maximum":60},
            "video_bit_rate":{"type":"integer","minimum":128000,"maximum":16000000},
            "audio":{"type":"boolean"},"control":{"type":"boolean"},"clipboard_autosync":{"type":"boolean"},
            "reconnect_attempts":{"type":"integer","minimum":0,"maximum":0}
          },
          "required":["device_id"]
        }
      }
    ]
  },
  "operations": [
    {
      "name": "runtime.status",
      "title": "检查投屏运行工具",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 150000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "record",
      "title": "录制设备画面",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 150000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 120000
          },
          "max_size": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096
          },
          "max_fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          }
        },
        "required": [
          "device_id",
          "duration_ms"
        ]
      }
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "投屏配置",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "title": "配置格式版本",
          "const": 1,
          "default": 1,
          "readOnly": true
        },
        "scrcpy": {
          "type": "string",
          "title": "scrcpy 入口",
          "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
          "minLength": 1,
          "maxLength": 4096
        },
        "adb": {
          "type": "string",
          "title": "ADB 入口",
          "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
          "minLength": 1,
          "maxLength": 4096
        },
        "live": {
          "type": [
            "object",
            "null"
          ],
          "title": "浏览器直播",
          "additionalProperties": false,
          "properties": {
            "scrcpy_server": {
              "type": "string",
              "title": "scrcpy 服务文件",
              "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
              "minLength": 1,
              "maxLength": 4096
            },
            "server_version": {
              "type": "string",
              "title": "服务版本",
              "description": "须与服务文件版本一致；Android 17 推荐使用 3.3.4。",
              "enum": ["3.3.1", "3.3.4"],
              "default": "3.3.4"
            },
            "video_encoder": {
              "type": [
                "string",
                "null"
              ],
              "title": "视频编码器",
              "description": "可选设备编码器名称。",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          },
          "required": [
            "scrcpy_server",
            "server_version"
          ]
        }
      },
      "required": [
        "format_version",
        "scrcpy",
        "adb"
      ]
    },
    "defaults": {
      "format_version": 1,
      "scrcpy": "scrcpy",
      "adb": "adb"
    },
    "apply_policy": "next_invocation",
    "legacy_filename": "mirroring.config.json"
  }
}

{
  "format_version": 1,
  "host_api_version": 2,
  "id": "mirroring",
  "version": "0.1.0",
  "name": "设备投屏与录制",
  "description": "提供实时画面、设备控制及录制。完整发布包自动准备并绑定 ADB、scrcpy 和匹配的 scrcpy-server 3.3.4；用户只需选择目标设备并确认连接与控制权限，无需单独填写必需工具路径。",
  "components": [
    {
      "id": "mirroring",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [
    {
      "id": "adb",
      "version": "36.0.0",
      "required": true,
      "variants": [],
      "bindings": [
        {
          "component_id": "mirroring",
          "config_pointer": "/adb",
          "entry": "adb"
        }
      ]
    },
    {
      "id": "scrcpy",
      "version": "3.3.4",
      "required": true,
      "variants": [],
      "bindings": [
        {
          "component_id": "mirroring",
          "config_pointer": "/scrcpy",
          "entry": "scrcpy"
        }
      ]
    },
    {
      "id": "scrcpy-server",
      "version": "3.3.4",
      "required": true,
      "variants": [],
      "bindings": [
        {
          "component_id": "mirroring",
          "config_pointer": "/live/scrcpy_server",
          "entry": "server"
        }
      ]
    }
  ],
  "requirements": [
    {
      "component_id": "mirroring",
      "config_pointer": "/live/server_version",
      "title": "直播服务版本",
      "description": "必须与安装的 scrcpy-server 版本一致，本声明使用 3.3.4。",
      "sensitive": false,
      "required": true
    }
  ]
}

{
  "format_version": 2,
  "host_api_version": 2,
  "id": "ai-assistant",
  "version": "0.1.0",
  "name": "AI 测试助手",
  "description": "提供 CLI 单次请求、持续会话、线程查询与关闭及实时输出。通过本机发现、共享复用或声明的官方来源自动准备和绑定 Codex CLI；用户配置授权项目、认证与运行环境等业务输入。",
  "components": [
    {
      "id": "ai-assistant",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [],
  "dependencies": {
    "format_version": 1,
    "dependencies": [
      {
        "id": "codex-cli",
        "entries": [
          "codex"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "CODEX_PATH",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "path",
            "value": "codex.exe",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "path",
            "value": "codex",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/codex",
            "entries": {
              "codex": "codex.exe"
            }
          }
        ],
        "name": "Codex 命令行",
        "probe": {
          "entry": "codex",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "=0.162.1",
        "required": true,
        "requires": [],
        "sources": [
          {
            "kind": "official",
            "url": "https://registry.npmjs.org/@openai/codex/-/codex-0.162.1-win32-x64.tgz",
            "platform": "win32-x64",
            "version": "0.162.1",
            "format": "tgz",
            "sha256": "5d48824f11a512b0ecb351461c2e90a1040c80de1026bc4a80815d5121f3936d",
            "size": 165053495,
            "entries": {
              "codex": "package/vendor/x86_64-pc-windows-msvc/bin/codex.exe"
            }
          }
        ],
        "bindings": [
          {
            "component_id": "ai-assistant",
            "config_pointer": "/executable",
            "entry": "codex"
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "component_id": "ai-assistant",
      "config_pointer": "/projects",
      "title": "授权项目目录",
      "description": "选择允许 AI 访问的本机项目目录；示例路径不能替代真实项目。",
      "sensitive": false,
      "required": true
    },
    {
      "component_id": "ai-assistant",
      "config_pointer": "/environment",
      "title": "AI 认证与环境",
      "description": "根据选定 CLI 的认证方式完成登录或配置环境；发行包不包含凭据。",
      "sensitive": true,
      "required": false
    }
  ]
}

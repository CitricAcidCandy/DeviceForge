{
  "format_version": 2,
  "host_api_version": 2,
  "id": "frida",
  "version": "0.1.0",
  "name": "Frida 动态调试",
  "description": "提供 Frida 服务部署与状态检查、进程枚举、脚本执行和权限分析。通过本机发现、共享复用或声明的官方来源自动准备和绑定 ADB、Frida 和 Frida 进程工具；用户准备匹配的设备端 frida-server 并确认设备权限。",
  "components": [
    {
      "id": "frida",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [],
  "dependencies": {
    "format_version": 1,
    "dependencies": [
      {
        "id": "adb",
        "entries": [
          "adb",
          "adb_win_api",
          "adb_win_usb_api"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "ADB_PATH",
            "entries": {
              "adb": ".",
              "adb_win_api": "AdbWinApi.dll",
              "adb_win_usb_api": "AdbWinUsbApi.dll"
            }
          },
          {
            "kind": "environment",
            "value": "APK_ADB",
            "entries": {
              "adb": ".",
              "adb_win_api": "AdbWinApi.dll",
              "adb_win_usb_api": "AdbWinUsbApi.dll"
            }
          },
          {
            "kind": "environment",
            "value": "ANDROID_SDK_ROOT",
            "entries": {
              "adb": "platform-tools/adb.exe",
              "adb_win_api": "platform-tools/AdbWinApi.dll",
              "adb_win_usb_api": "platform-tools/AdbWinUsbApi.dll"
            }
          },
          {
            "kind": "environment",
            "value": "ANDROID_HOME",
            "entries": {
              "adb": "platform-tools/adb.exe",
              "adb_win_api": "platform-tools/AdbWinApi.dll",
              "adb_win_usb_api": "platform-tools/AdbWinUsbApi.dll"
            }
          },
          {
            "kind": "path",
            "value": "adb.exe",
            "entries": {
              "adb": ".",
              "adb_win_api": "AdbWinApi.dll",
              "adb_win_usb_api": "AdbWinUsbApi.dll"
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/adb",
            "entries": {
              "adb": "adb.exe",
              "adb_win_api": "AdbWinApi.dll",
              "adb_win_usb_api": "AdbWinUsbApi.dll"
            }
          }
        ],
        "name": "Android 调试桥",
        "probe": {
          "entry": "adb",
          "args": [
            "version"
          ],
          "pattern": "Version ([0-9]+\\.[0-9]+\\.[0-9]+)",
          "timeout_ms": 3000
        },
        "version_requirement": ">=36.0.0, <37.0.0",
        "required": true,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "frida",
            "config_pointer": "/tools/adb",
            "entry": "adb"
          }
        ]
      },
      {
        "id": "frida",
        "entries": [
          "frida"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "FRIDA_PATH",
            "entries": {
              "frida": "."
            }
          },
          {
            "kind": "path",
            "value": "frida.exe",
            "entries": {
              "frida": "."
            }
          },
          {
            "kind": "path",
            "value": "frida",
            "entries": {
              "frida": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/frida",
            "entries": {
              "frida": "frida.exe"
            }
          }
        ],
        "name": "Frida 客户端",
        "probe": {
          "entry": "frida",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "=17.24.3",
        "required": true,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "frida",
            "config_pointer": "/tools/frida",
            "entry": "frida"
          }
        ]
      },
      {
        "id": "frida-ps",
        "entries": [
          "frida-ps"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "FRIDA_PS_PATH",
            "entries": {
              "frida-ps": "."
            }
          },
          {
            "kind": "path",
            "value": "frida-ps.exe",
            "entries": {
              "frida-ps": "."
            }
          },
          {
            "kind": "path",
            "value": "frida-ps",
            "entries": {
              "frida-ps": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/frida-ps",
            "entries": {
              "frida-ps": "frida-ps.exe"
            }
          }
        ],
        "name": "Frida 进程工具",
        "probe": {
          "entry": "frida-ps",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "=17.24.3",
        "required": true,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "frida",
            "config_pointer": "/tools/frida_ps",
            "entry": "frida-ps"
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "component_id": "frida",
      "config_pointer": "/server_path",
      "title": "设备端 Frida 服务",
      "description": "用户准备与主机 Frida 版本和设备架构匹配的 frida-server，并确认设备执行权限。",
      "sensitive": false,
      "required": false
    }
  ]
}

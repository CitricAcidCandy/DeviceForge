{
  "format_version": 1,
  "profiles": {
    "powershell": {
      "executable": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NoExit",
        "-Command",
        "$OutputEncoding = [Console]::InputEncoding = [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new()"
      ],
      "resource_scope": "direct_process"
    }
  }
}

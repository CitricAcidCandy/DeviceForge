{
  "format_version": 2,
  "host_api_version": 2,
  "id": "android-packages",
  "version": "0.1.0",
  "name": "Android 安装包工具",
  "description": "提供 Android 包内置解析，以及清单分析、签名报告、APK 提取、APKS 构建、资源解码和 SDK 扫描。Java、apkanalyzer、apksigner、bundletool 和 apktool 为可选工具，已提供时自动绑定，缺失时仅相应扩展能力不可用；用户提供上传产物与按需签名材料。",
  "components": [
    {
      "id": "android-packages",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [],
  "dependencies": {
    "format_version": 1,
    "dependencies": [
      {
        "id": "java",
        "entries": [
          "java"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "JAVA_PATH",
            "entries": {
              "java": "."
            }
          },
          {
            "kind": "environment",
            "value": "JAVA_HOME",
            "entries": {
              "java": "bin/java.exe"
            }
          },
          {
            "kind": "path",
            "value": "java.exe",
            "entries": {
              "java": "."
            }
          },
          {
            "kind": "path",
            "value": "java",
            "entries": {
              "java": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/java",
            "entries": {
              "java": "java.exe"
            }
          }
        ],
        "name": "Java 运行环境",
        "probe": {
          "entry": "java",
          "args": [
            "-version"
          ],
          "pattern": "version \"([0-9]+\\.[0-9]+\\.[0-9]+)",
          "timeout_ms": 3000
        },
        "version_requirement": "*",
        "required": false,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "android-packages",
            "config_pointer": "/tools/java",
            "entry": "java"
          }
        ]
      },
      {
        "id": "apkanalyzer",
        "entries": [
          "apkanalyzer"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "APKANALYZER_PATH",
            "entries": {
              "apkanalyzer": "."
            }
          },
          {
            "kind": "path",
            "value": "apkanalyzer.exe",
            "entries": {
              "apkanalyzer": "."
            }
          },
          {
            "kind": "path",
            "value": "apkanalyzer",
            "entries": {
              "apkanalyzer": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/apkanalyzer",
            "entries": {
              "apkanalyzer": "apkanalyzer.exe"
            }
          }
        ],
        "name": "Android APK 分析器",
        "probe": {
          "entry": "apkanalyzer",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "*",
        "required": false,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "android-packages",
            "config_pointer": "/tools/apkanalyzer/executable",
            "entry": "apkanalyzer"
          }
        ]
      },
      {
        "id": "apksigner",
        "entries": [
          "jar"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "APKSIGNER_JAR",
            "entries": {
              "jar": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/apksigner",
            "entries": {
              "jar": "apksigner.jar"
            }
          }
        ],
        "name": "Android APK 签名器",
        "requires": [
          "java"
        ],
        "version_requirement": "*",
        "required": false,
        "sources": [],
        "bindings": [
          {
            "component_id": "android-packages",
            "config_pointer": "/tools/apksigner/jar",
            "entry": "jar"
          }
        ]
      },
      {
        "id": "bundletool",
        "entries": [
          "jar"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "BUNDLETOOL_JAR",
            "entries": {
              "jar": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/bundletool",
            "entries": {
              "jar": "bundletool.jar"
            }
          }
        ],
        "name": "Android Bundle 工具",
        "requires": [
          "java"
        ],
        "version_requirement": "=1.3.0",
        "required": false,
        "sources": [],
        "bindings": [
          {
            "component_id": "android-packages",
            "config_pointer": "/tools/bundletool/jar",
            "entry": "jar"
          }
        ]
      },
      {
        "id": "apktool",
        "entries": [
          "jar"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "APKTOOL_JAR",
            "entries": {
              "jar": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/apktool",
            "entries": {
              "jar": "apktool.jar"
            }
          }
        ],
        "name": "Android 资源解码器",
        "requires": [
          "java"
        ],
        "version_requirement": "=2.9.0",
        "required": false,
        "sources": [],
        "bindings": [
          {
            "component_id": "android-packages",
            "config_pointer": "/tools/apktool/jar",
            "entry": "jar"
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "component_id": "android-packages",
      "config_pointer": "/tools",
      "title": "按能力选择工具类型",
      "description": "启用工具能力时填写对应工具的 kind：APK 分析 executable，JAR 使用 java_jar；不填工具仍可使用内置解析能力。",
      "sensitive": false,
      "required": false
    },
    {
      "component_id": "android-packages",
      "config_pointer": "/signing",
      "title": "签名材料",
      "description": "仅签名操作需要 keystore、alias 和口令文件；私钥和口令不得进入发行包。",
      "sensitive": true,
      "required": false
    }
  ]
}

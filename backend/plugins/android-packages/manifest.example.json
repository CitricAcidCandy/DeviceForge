{
  "id": "android-packages",
  "version": "0.1.0",
  "protocol_version": 4,
  "args": [],
  "artifacts": {
    "input_fields": [
      "artifact_id"
    ],
    "input_pointers": [],
    "outputs": true
  },
  "operations": [
    {
      "name": "manifest",
      "title": "分析 APK / AAB 清单",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "signature",
      "title": "验证 APK 签名",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "extract_apk",
      "title": "提取 APKS 内精确 APK 条目",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 360000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "entry": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "required": [
          "artifact_id",
          "entry"
        ]
      }
    },
    {
      "name": "build_apks",
      "title": "将 AAB 构建为签名 APKS",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 120000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "universal"
            ]
          }
        },
        "required": [
          "artifact_id",
          "mode"
        ]
      }
    },
    {
      "name": "decode",
      "title": "反编译 APK 为 ZIP",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 480000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "scan_sdks",
      "title": "检测反编译产物的 SDK 路径",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "package_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*([.][A-Za-z_$][A-Za-z0-9_$]*)*$"
                },
                "class_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": [
                "name",
                "package_path"
              ]
            }
          }
        },
        "required": [
          "artifact_id",
          "rules"
        ]
      }
    },
    {
      "name": "extract_splits",
      "title": "按设备规格离线提取 APKS 分包",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 120000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "device_spec": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supported_abis": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "supported_locales": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "screen_density": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "sdk_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "required": [
              "supported_abis",
              "supported_locales",
              "screen_density",
              "sdk_version"
            ]
          }
        },
        "required": [
          "artifact_id",
          "device_spec"
        ]
      }
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "Android 包处理配置",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "title": "配置格式版本",
          "const": 1,
          "default": 1,
          "readOnly": true
        },
        "tools": {
          "type": "object",
          "title": "包处理工具",
          "additionalProperties": false,
          "properties": {
            "java": {
              "type": [
                "string",
                "null"
              ],
              "title": "Java 入口",
              "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
              "minLength": 1,
              "maxLength": 4096
            },
            "apkanalyzer": {
              "type": [
                "object",
                "null"
              ],
              "title": "Apkanalyzer",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "title": "工具入口类型",
                  "const": "executable",
                  "default": "executable",
                  "readOnly": true
                },
                "executable": {
                  "type": "string",
                  "title": "可执行程序",
                  "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "kind",
                "executable"
              ]
            },
            "apksigner": {
              "title": "Apksigner",
              "anyOf": [
                {
                  "type": "object",
                  "title": "可执行程序",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "title": "工具入口类型",
                      "const": "executable",
                      "default": "executable",
                      "readOnly": true
                    },
                    "executable": {
                      "type": "string",
                      "title": "可执行程序",
                      "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "kind",
                    "executable"
                  ]
                },
                {
                  "type": "object",
                  "title": "Java JAR",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "title": "工具入口类型",
                      "const": "java_jar",
                      "default": "java_jar",
                      "readOnly": true
                    },
                    "jar": {
                      "type": "string",
                      "title": "JAR 文件",
                      "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
                      "minLength": 1,
                      "maxLength": 4096
                    }
                  },
                  "required": [
                    "kind",
                    "jar"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "bundletool": {
              "type": [
                "object",
                "null"
              ],
              "title": "Bundletool",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "title": "工具入口类型",
                  "const": "java_jar",
                  "default": "java_jar",
                  "readOnly": true
                },
                "jar": {
                  "type": "string",
                  "title": "JAR 文件",
                  "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "kind",
                "jar"
              ]
            },
            "apktool": {
              "type": [
                "object",
                "null"
              ],
              "title": "Apktool",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "title": "工具入口类型",
                  "const": "java_jar",
                  "default": "java_jar",
                  "readOnly": true
                },
                "jar": {
                  "type": "string",
                  "title": "JAR 文件",
                  "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
                  "minLength": 1,
                  "maxLength": 4096
                }
              },
              "required": [
                "kind",
                "jar"
              ]
            }
          }
        },
        "signing": {
          "type": [
            "object",
            "null"
          ],
          "title": "签名配置",
          "additionalProperties": false,
          "properties": {
            "keystore": {
              "type": "string",
              "title": "签名密钥库",
              "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
              "minLength": 1,
              "maxLength": 4096
            },
            "alias": {
              "type": "string",
              "title": "签名别名",
              "description": "",
              "minLength": 1,
              "maxLength": 200
            },
            "store_password_file": {
              "type": "string",
              "title": "密钥库密码文件",
              "description": "仅填写本机密码文件绝对路径，不在配置中存放密码。",
              "minLength": 1,
              "maxLength": 4096
            },
            "key_password_file": {
              "type": "string",
              "title": "私钥密码文件",
              "description": "仅填写本机密码文件绝对路径，不在配置中存放密码。",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "keystore",
            "alias",
            "store_password_file",
            "key_password_file"
          ]
        },
        "scratch_root": {
          "type": [
            "string",
            "null"
          ],
          "title": "临时目录",
          "description": "本机绝对目录；自动化和 Frida 要求目录已存在。",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "format_version"
      ]
    },
    "defaults": {
      "format_version": 1,
      "tools": {}
    },
    "apply_policy": "next_invocation",
    "legacy_filename": "android-packages.config.json"
  }
}

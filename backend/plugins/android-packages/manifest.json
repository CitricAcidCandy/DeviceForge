{
  "id": "android-packages",
  "version": "0.1.0",
  "protocol_version": 4,
  "args": [],
  "artifacts": {
    "input_fields": [
      "artifact_id"
    ],
    "input_pointers": [],
    "outputs": true
  },
  "operations": [
    {
      "name": "manifest",
      "title": "分析 APK / AAB 清单",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "module": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,79}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "signature",
      "title": "验证 APK 签名",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "extract_apk",
      "title": "提取 APKS 内精确 APK 条目",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 360000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "entry": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "required": [
          "artifact_id",
          "entry"
        ]
      }
    },
    {
      "name": "build_apks",
      "title": "将 AAB 构建为签名 APKS",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 120000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "universal"
            ]
          }
        },
        "required": [
          "artifact_id",
          "mode"
        ]
      }
    },
    {
      "name": "decode",
      "title": "反编译 APK 为 ZIP",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 480000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          }
        },
        "required": [
          "artifact_id"
        ]
      }
    },
    {
      "name": "scan_sdks",
      "title": "检测反编译产物的 SDK 路径",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 240000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "package_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*([.][A-Za-z_$][A-Za-z0-9_$]*)*$"
                },
                "class_name": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
                }
              },
              "required": [
                "name",
                "package_path"
              ]
            }
          }
        },
        "required": [
          "artifact_id",
          "rules"
        ]
      }
    },
    {
      "name": "extract_splits",
      "title": "按设备规格离线提取 APKS 分包",
      "execution": {
        "api_version": 1,
        "total_timeout_ms": 120000
      },
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "device_spec": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "supported_abis": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "supported_locales": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              },
              "screen_density": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "sdk_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "device_features": {
                "type":"array","maxItems":256,"uniqueItems":true,
                "items":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9_.:-]+$"}
              },
              "gl_extensions": {
                "type":"array","maxItems":256,"uniqueItems":true,
                "items":{"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z0-9_.:-]+$"}
              },
              "codename": {
                "type":["string","null"],"minLength":1,"maxLength":80,"pattern":"^[A-Za-z0-9_-]+$"
              },
              "device_tier": {
                "type":["string","null"],"minLength":1,"maxLength":80,"pattern":"^[A-Za-z0-9_-]+$"
              }
            },
            "required": [
              "supported_abis",
              "supported_locales",
              "screen_density",
              "sdk_version"
            ]
          },
          "modules": {
            "type":["array","null"],"minItems":1,"maxItems":128,"uniqueItems":true,
            "items":{"type":"string","minLength":1,"maxLength":80,"pattern":"^[A-Za-z][A-Za-z0-9_]*$"},
            "description":"省略或null沿原默认匹配；ALL必须单独选择，运行时另校混用"
          },
          "instant": {"type":"boolean","description":"仅提取支持；缺省false保持原argv"}
        },
        "required": [
          "artifact_id",
          "device_spec"
        ]
      }
    }
  ]
}

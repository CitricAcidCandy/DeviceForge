{
  "format_version": 1,
  "dependencies": [
    {
      "id": "java",
      "entries": [
        "java"
      ],
      "discovery": [
        {
          "kind": "environment",
          "value": "JAVA_PATH",
          "entries": {
            "java": "."
          }
        },
        {
          "kind": "environment",
          "value": "JAVA_HOME",
          "entries": {
            "java": "bin/java.exe"
          }
        },
        {
          "kind": "path",
          "value": "java.exe",
          "entries": {
            "java": "."
          }
        },
        {
          "kind": "path",
          "value": "java",
          "entries": {
            "java": "."
          }
        },
        {
          "kind": "user_directory",
          "value": "tools/java",
          "entries": {
            "java": "java.exe"
          }
        }
      ],
      "name": "Java 运行环境",
      "probe": {
        "entry": "java",
        "args": [
          "-version"
        ],
        "pattern": "version \"([0-9]+\\.[0-9]+\\.[0-9]+)",
        "timeout_ms": 3000
      },
      "version_requirement": "*",
      "required": false,
      "requires": [],
      "sources": [],
      "bindings": [
        {
          "component_id": "android-packages",
          "config_pointer": "/tools/java",
          "entry": "java"
        }
      ]
    },
    {
      "id": "apkanalyzer",

{
  "format_version": 1,
  "dependencies": [
    {
      "id": "node",
      "entries": [
        "node"
      ],
      "discovery": [
        {
          "kind": "environment",
          "value": "NODE_PATH",
          "entries": {
            "node": "."
          }
        },
        {
          "kind": "path",
          "value": "node.exe",
          "entries": {
            "node": "."
          }
        },
        {
          "kind": "path",
          "value": "node",
          "entries": {
            "node": "."
          }
        },
        {
          "kind": "user_directory",
          "value": "tools/node",
          "entries": {
            "node": "node.exe"
          }
        }
      ],
      "name": "Node.js 运行环境",
      "probe": {
        "entry": "node",
        "args": [
          "--version"
        ],
        "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
        "timeout_ms": 3000
      },
      "version_requirement": "=24.14.0",
      "required": true,
      "requires": [],
      "sources": [
        {
          "kind": "official",
          "url": "https://nodejs.org/dist/v24.14.0/node-v24.14.0-win-x64.zip",
          "platform": "win32-x64",
          "version": "24.14.0",
          "format": "zip",
          "sha256": "313fa40c0d7b18575821de8cb17483031fe07d95de5994f6f435f3b345f85c66",
          "size": 36217529,
          "entries": {
            "node": "node-v24.14.0-win-x64/node.exe"
          }
        }
      ],
      "bindings": [
        {
          "component_id": "ai-sdk",
          "config_pointer": "/node_executable",
          "entry": "node"
        }
      ]
    },
    {
      "id": "codex-sdk",
      "entries": [
        "sdk"
      ],
      "discovery": [
        {
          "kind": "environment",
          "value": "CODEX_SDK_ENTRY",
          "entries": {
            "sdk": "."
          }
        },
        {
          "kind": "user_directory",
          "value": "tools/codex-sdk",
          "entries": {
            "sdk": "dist/index.js"
          }
        }
      ],
      "name": "Codex TypeScript SDK",
      "requires": [

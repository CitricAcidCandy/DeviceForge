        {
          "kind": "official",
          "url": "https://registry.npmjs.org/@openai/codex-sdk/-/codex-sdk-0.162.1.tgz",
          "platform": "win32-x64",
          "version": "0.162.1",
          "format": "tgz",
          "sha256": "ae10b9096bb72ebdf1fbac598fd87960afc1ddf5b8980fa0d38bdd6770400349",
          "size": 21406,
          "entries": {
            "sdk": "package/dist/index.js"
          }
        }
      ],
      "bindings": [
        {
          "component_id": "ai-sdk",
          "config_pointer": "/sdk_entry",
          "entry": "sdk"
        }
      ]
    },
    {
      "id": "codex-cli",

{
  "format_version": 2,
  "host_api_version": 2,
  "id": "ai-sdk",
  "version": "0.1.0",
  "name": "AI SDK 桥接",
  "description": "提供 SDK 单次请求、线程恢复、实时会话和助手编排。组件提供 worker，通过本机发现、共享复用或声明的官方来源自动准备与绑定 Node、Codex SDK 和 CLI；用户配置授权项目、认证目录和线程存储等业务输入。",
  "components": [
    {
      "id": "ai-sdk",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [],
  "dependencies": {
    "format_version": 1,
    "dependencies": [
      {
        "id": "node",
        "entries": [
          "node"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "NODE_PATH",
            "entries": {
              "node": "."
            }
          },
          {
            "kind": "path",
            "value": "node.exe",
            "entries": {
              "node": "."
            }
          },
          {
            "kind": "path",
            "value": "node",
            "entries": {
              "node": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/node",
            "entries": {
              "node": "node.exe"
            }
          }
        ],
        "name": "Node.js 运行环境",
        "probe": {
          "entry": "node",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "=24.14.0",
        "required": true,
        "requires": [],
        "sources": [
          {
            "kind": "official",
            "url": "https://nodejs.org/dist/v24.14.0/node-v24.14.0-win-x64.zip",
            "platform": "win32-x64",
            "version": "24.14.0",
            "format": "zip",
            "sha256": "313fa40c0d7b18575821de8cb17483031fe07d95de5994f6f435f3b345f85c66",
            "size": 36217529,
            "entries": {
              "node": "node-v24.14.0-win-x64/node.exe"
            }
          }
        ],
        "bindings": [
          {
            "component_id": "ai-sdk",
            "config_pointer": "/node_executable",
            "entry": "node"
          }
        ]
      },
      {
        "id": "codex-sdk",
        "entries": [
          "sdk"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "CODEX_SDK_ENTRY",
            "entries": {
              "sdk": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/codex-sdk",
            "entries": {
              "sdk": "dist/index.js"
            }
          }
        ],
        "name": "Codex TypeScript SDK",
        "requires": [
          "node"
        ],
        "version_requirement": "=0.162.1",
        "required": true,
        "sources": [
          {
            "kind": "official",
            "url": "https://registry.npmjs.org/@openai/codex-sdk/-/codex-sdk-0.162.1.tgz",
            "platform": "win32-x64",
            "version": "0.162.1",
            "format": "tgz",
            "sha256": "ae10b9096bb72ebdf1fbac598fd87960afc1ddf5b8980fa0d38bdd6770400349",
            "size": 21406,
            "entries": {
              "sdk": "package/dist/index.js"
            }
          }
        ],
        "bindings": [
          {
            "component_id": "ai-sdk",
            "config_pointer": "/sdk_entry",
            "entry": "sdk"
          }
        ]
      },
      {
        "id": "codex-cli",
        "entries": [
          "codex"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "CODEX_PATH",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "path",
            "value": "codex.exe",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "path",
            "value": "codex",
            "entries": {
              "codex": "."
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/codex",
            "entries": {
              "codex": "codex.exe"
            }
          }
        ],
        "name": "Codex 命令行",
        "probe": {
          "entry": "codex",
          "args": [
            "--version"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "timeout_ms": 3000
        },
        "version_requirement": "=0.162.1",
        "required": true,
        "requires": [],
        "sources": [
          {
            "kind": "official",
            "url": "https://registry.npmjs.org/@openai/codex/-/codex-0.162.1-win32-x64.tgz",
            "platform": "win32-x64",
            "version": "0.162.1",
            "format": "tgz",
            "sha256": "5d48824f11a512b0ecb351461c2e90a1040c80de1026bc4a80815d5121f3936d",
            "size": 165053495,
            "entries": {
              "codex": "package/vendor/x86_64-pc-windows-msvc/bin/codex.exe"
            }
          }
        ],
        "bindings": [
          {
            "component_id": "ai-sdk",
            "config_pointer": "/cli_executable",
            "entry": "codex"
          }
        ]
      }
    ]
  },
  "requirements": [
    {
      "component_id": "ai-sdk",
      "config_pointer": "/projects",
      "title": "授权项目目录",
      "description": "选择允许 SDK 访问的实际项目目录。",
      "sensitive": false,
      "required": true
    },
    {
      "component_id": "ai-sdk",
      "config_pointer": "/codex_home",
      "title": "提供方认证目录",
      "description": "选择属于当前服务用户的已认证 Codex 目录；发行包不包含登录状态。",
      "sensitive": false,
      "required": true
    },
    {
      "component_id": "ai-sdk",
      "config_pointer": "/state_root",
      "title": "线程持久化目录",
      "description": "选择 SDK 桥接线程与资格记录的实际存储目录。",
      "sensitive": false,
      "required": true
    }
  ]
}

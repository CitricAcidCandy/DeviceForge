{
  "id": "ai-sdk",
  "version": "0.1.0",
  "protocol_version": 4,
  "executable": "deviceforge-ai-sdk-plugin.exe",
  "args": [],
  "operations": [
    {
      "name": "runtime.status", "title": "查询官方SDK运行资格",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": { "type": "object", "additionalProperties": false, "properties": {}, "required": [] }
    },
    {
      "name": "sdk.single", "title": "官方SDK单次请求",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 131072 }
        },
        "required": ["project_id", "prompt"]
      }
    },
    {
      "name": "sdk.turn", "title": "官方SDK线程轮次",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
          "prompt": { "type": "string", "minLength": 1, "maxLength": 131072 },
          "thread_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
        },
        "required": ["project_id", "prompt"]
      }
    },
    {
      "name": "session.get", "title": "查询官方SDK线程资格",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
          "thread_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
        },
        "required": ["project_id", "thread_id"]
      }
    },
    {
      "name": "session.close", "title": "关闭官方SDK线程资格",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
          "thread_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
        },
        "required": ["project_id", "thread_id"]
      }
    },
    {
      "name": "assistant.run", "title": "官方SDK四轮测试助手",
      "execution": { "api_version": 1, "total_timeout_ms": 600000 },
      "input_schema": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
          "user_prompt": { "type": "string", "minLength": 1, "maxLength": 131072 },
          "stream_output": { "type": "boolean", "default": false }
        },
        "required": ["project_id"]
      }
    }
  ],
  "sessions": {
    "protocol_version": 5,
    "operations": [
      {
        "name": "sdk.stream", "title": "官方SDK实时线程轮次",
        "execution": { "api_version": 1, "total_timeout_ms": 600000 },
        "input_schema": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "project_id": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_-]+$" },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 131072 },
            "thread_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
          },
          "required": ["project_id", "prompt"]
        }
      }
    ]
  },
  "configuration": {
    "version": 1,
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "固定资格 AI SDK 配置",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "title": "配置格式版本",
          "const": 1,
          "default": 1,
          "readOnly": true
        },
        "profile": {
          "type": "string",
          "title": "资格档案",
          "const": "codex_sdk_ts_0_162_1_node24",
          "default": "codex_sdk_ts_0_162_1_node24",
          "readOnly": true
        },
        "node_executable": {
          "type": "string",
          "title": "Node.js 入口",
          "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
          "minLength": 1,
          "maxLength": 4096
        },
        "node_version": {
          "type": "string",
          "title": "Node.js 资格版本",
          "const": "24.14.0",
          "default": "24.14.0",
          "readOnly": true
        },
        "sdk_entry": {
          "type": "string",
          "title": "SDK 模块入口",
          "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
          "minLength": 1,
          "maxLength": 4096
        },
        "sdk_version": {
          "type": "string",
          "title": "SDK 资格版本",
          "const": "0.162.1",
          "default": "0.162.1",
          "readOnly": true
        },
        "cli_executable": {
          "type": "string",
          "title": "CLI 入口",
          "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
          "minLength": 1,
          "maxLength": 4096
        },
        "cli_version": {
          "type": "string",
          "title": "CLI 资格版本",
          "const": "0.162.1",
          "default": "0.162.1",
          "readOnly": true
        },
        "projects": {
          "type": "object",
          "title": "允许访问的项目",
          "additionalProperties": {
            "type": "string",
            "title": "项目目录",
            "description": "填写本机绝对路径；运行时继续检查路径资格和文件状态。",
            "minLength": 1,
            "maxLength": 4096
          },
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          }
        },
        "state_root": {
          "type": "string",
          "title": "资格与会话目录",
          "description": "本机绝对目录，不能与提供者目录重合或互为父子目录。",
          "minLength": 1,
          "maxLength": 4096
        },
        "codex_home": {
          "type": "string",
          "title": "提供者目录",
          "description": "本机绝对目录，与会话目录保持分离。",
          "minLength": 1,
          "maxLength": 4096
        },
        "environment": {
          "type": "object",
          "title": "提供者环境变量",
          "additionalProperties": {
            "type": "string",
            "title": "环境变量值",
            "maxLength": 8192,
            "writeOnly": true,
            "format": "password"
          },
          "description": "可能包含密钥，保存后界面只显示已设置；不继承服务凭据。",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_]+$",
            "maxLength": 128,
            "not": {
              "const": "APK_API_TOKEN"
            }
          }
        },
        "thread_options": {
          "type": "object",
          "title": "固定 SDK 线程选项",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "title": "模型名称",
              "description": "",
              "minLength": 1,
              "maxLength": 128
            },
            "threadSource": {
              "type": "string",
              "title": "线程来源",
              "description": "",
              "minLength": 1,
              "maxLength": 128
            },
            "sandboxMode": {
              "type": "string",
              "title": "沙箱模式",
              "enum": [
                "read-only",
                "workspace-write",
                "danger-full-access"
              ]
            },
            "approvalPolicy": {
              "type": "string",
              "title": "批准策略",
              "enum": [
                "never",
                "on-request",
                "on-failure",
                "untrusted"
              ]
            },
            "modelReasoningEffort": {
              "type": "string",
              "title": "推理强度",
              "enum": [
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max",
                "ultra",
                "persistent"
              ]
            },
            "webSearchMode": {
              "type": "string",
              "title": "网络搜索模式",
              "enum": [
                "disabled",
                "cached",
                "live"
              ]
            },
            "skipGitRepoCheck": {
              "type": "boolean",
              "title": "跳过 Git 仓库检查",
              "default": false
            },
            "networkAccessEnabled": {
              "type": "boolean",
              "title": "启用网络访问",
              "default": false
            },
            "webSearchEnabled": {
              "type": "boolean",
              "title": "启用网络搜索（旧开关）",
              "default": false
            }
          },
          "not": {
            "required": [
              "webSearchMode",
              "webSearchEnabled"
            ]
          }
        }
      },
      "required": [
        "format_version",
        "profile",
        "node_executable",
        "node_version",
        "sdk_entry",
        "sdk_version",
        "cli_executable",
        "cli_version",
        "projects",
        "state_root",
        "codex_home"
      ]
    },
    "defaults": {
      "format_version": 1,
      "profile": "codex_sdk_ts_0_162_1_node24",
      "node_executable": "C:/DeviceForge/runtime/node/node.exe",
      "node_version": "24.14.0",
      "sdk_entry": "C:/DeviceForge/runtime/sdk/dist/index.js",
      "sdk_version": "0.162.1",
      "cli_executable": "C:/DeviceForge/runtime/cli/cli.exe",
      "cli_version": "0.162.1",
      "projects": {
        "demo": "C:/DeviceForge/projects/demo"
      },
      "state_root": "C:/DeviceForge/data/ai-sdk/qualification",
      "codex_home": "C:/DeviceForge/data/ai-sdk/provider",
      "environment": {},
      "thread_options": {}
    },
    "apply_policy": "next_invocation",
    "legacy_filename": "ai-sdk.config.json"
  }
}

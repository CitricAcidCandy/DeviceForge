{
  "id": "settings",
  "version": "0.1.0",
  "protocol_version": 4,
  "executable": "deviceforge-settings-plugin.exe",
  "args": [],
  "operations": [
    {
      "name": "list",
      "title": "列出配置",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "scope",
          "owner_id"
        ]
      }
    },
    {
      "name": "get",
      "title": "读取配置",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "scope",
          "owner_id",
          "section"
        ]
      }
    },
    {
      "name": "set",
      "title": "原子写入配置",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "value": {}
        },
        "required": [
          "scope",
          "owner_id",
          "section",
          "expected_revision",
          "value"
        ]
      }
    },
    {
      "name": "delete",
      "title": "删除配置区",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "scope",
          "owner_id",
          "section",
          "expected_revision"
        ]
      }
    },
    {
      "name": "import",
      "title": "导入旧配置",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "sections": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "additionalProperties": true
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "scope",
          "owner_id",
          "sections",
          "expected_revision"
        ]
      }
    },
    {
      "name": "remote.load",
      "title": "读取远端配置并保留备份",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "scope",
          "owner_id",
          "section",
          "expected_revision"
        ]
      },
      "execution": {
        "total_timeout_ms": 30000,
        "api_version": 1
      }
    },
    {
      "name": "remote.save",
      "title": "保存远端配置并保留备份",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "workspace"
            ]
          },
          "owner_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "section": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "expected_revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "value": {},
          "write_local_backup": {
            "type": "boolean",
            "default": true,
            "description": "远端保存确认后是否更新本地备份；关闭时保留本地内容和修订"
          }
        },
        "required": [
          "scope",
          "owner_id",
          "section",
          "expected_revision",
          "value"
        ]
      },
      "execution": {
        "total_timeout_ms": 30000,
        "api_version": 1
      }
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "配置存储插件",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "title": "配置格式版本",
          "const": 1,
          "default": 1,
          "readOnly": true
        },
        "storage_root": {
          "type": "string",
          "title": "配置存储根目录",
          "description": "本机绝对目录。切换根目录仅改变后续读写位置，不自动迁移原数据。",
          "minLength": 1,
          "maxLength": 4096
        },
        "remote": {
          "type": [
            "object",
            "null"
          ],
          "title": "远端配置存储",
          "additionalProperties": false,
          "properties": {
            "base_url": {
              "type": "string",
              "title": "远端目录地址",
              "description": "HTTP 或 HTTPS 目录地址，末尾保留 /，不允许地址凭据、查询和片段。",
              "minLength": 1,
              "maxLength": 2048
            },
            "headers": {
              "type": "object",
              "title": "远端请求头",
              "additionalProperties": {
                "type": "string",
                "title": "请求头值",
                "writeOnly": true,
                "format": "password"
              },
              "maxProperties": 32,
              "description": "可能含敏感值，界面不回显。"
            }
          },
          "required": [
            "base_url"
          ]
        }
      },
      "required": [
        "format_version",
        "storage_root"
      ]
    },
    "defaults": {
      "format_version": 1,
      "storage_root": "C:/DeviceForge/data/settings"
    },
    "apply_policy": "next_invocation",
    "legacy_filename": "settings.config.json"
  }
}

    {
      "name": "input",
      "title": "派发Android输入",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^-]",
            "not": {
              "anyOf": [
                {
                  "pattern": "^\\s*$"
                },
                {
                  "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                }
              ]
            },
            "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "tap"
                      },
                      "x": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      }
                    },
                    "required": [
                      "kind",
                      "x",
                      "y"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "swipe"
                      },
                      "x1": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      },
                      "y1": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      },
                      "x2": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      },
                      "y2": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 32767
                      },
                      "duration_ms": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      }
                    },
                    "required": [
                      "kind",
                      "x1",
                      "y1",
                      "x2",
                      "y2",
                      "duration_ms"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "keyevent"
                      },
                      "key_code": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "long_press": {
                        "type": "boolean",
                        "default": false
                      }
                    },
                    "required": [
                      "kind",
                      "key_code"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "text"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "description": "ASCII运行时限1024字节；Unicode运行时限4096字节并要求显式ADB Keyboard配置"
                      },
                      "enter": {
                        "type": "boolean",
                        "default": false
                      }
                    },
                    "required": [
                      "kind",
                      "text"
                    ]
                  }
                ]
              }
            },
            "required": [
              "action"
            ]
          }
        },
        "required": [
          "device_id",
          "input"
        ]
      }

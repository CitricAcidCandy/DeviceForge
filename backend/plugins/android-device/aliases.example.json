{
  "format_version": 2,
  "bindings": [
    {
      "operation": {
        "id": "android.devices",
        "title": "发现Android设备",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        }
      },
      "target": {
        "kind": "device_discovery",
        "plugin_id": "android-device"
      },
      "input": "identity",
      "result": {
        "kind": "device_discovery",
        "platform": "android"
      }
    },
    {
      "operation": {
        "id": "android.connect",
        "title": "连接Android设备",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\]):[0-9]+$",
              "description": "运行时校验IPv4/DNS或方括号IPv6及1至65535端口"
            }
          },
          "required": [
            "address"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "connect",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.disconnect",
        "title": "断开指定Android连接",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "address": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^(?:[A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\]):[0-9]+$",
              "description": "运行时校验IPv4/DNS或方括号IPv6及1至65535端口"
            }
          },
          "required": [
            "address"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "disconnect",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.packages",
        "title": "列出Android应用",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^-]",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^\\s*$"
                  },
                  {
                    "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                  }
                ]
              },
              "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
            }
          },
          "required": [
            "device_id"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "packages",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.app.start",
        "title": "启动Android应用",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^-]",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^\\s*$"
                  },
                  {
                    "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                  }
                ]
              },
              "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
            },
            "package": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
            }
          },
          "required": [
            "device_id",
            "package"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "app.start",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.app.stop",
        "title": "停止Android应用",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^-]",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^\\s*$"
                  },
                  {
                    "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                  }
                ]
              },
              "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
            },
            "package": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
            }
          },
          "required": [
            "device_id",
            "package"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "app.stop",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.app.uninstall",
        "title": "卸载Android应用",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^-]",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^\\s*$"
                  },
                  {
                    "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                  }
                ]
              },
              "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
            },
            "package": {
              "type": "string",
              "minLength": 3,
              "maxLength": 200,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"
            }
          },
          "required": [
            "device_id",
            "package"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "app.uninstall",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    },
    {
      "operation": {
        "id": "android.input",
        "title": "派发Android输入",
        "input_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^-]",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^\\s*$"
                  },
                  {
                    "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                  }
                ]
              },
              "description": "保留原文；运行时另校最多200个UTF-8字节，不以ASCII字符集收紧"
            },
            "action": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "tap"
                    },
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    }
                  },
                  "required": [
                    "kind",
                    "x",
                    "y"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "swipe"
                    },
                    "x1": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    },
                    "y1": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    },
                    "x2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    },
                    "y2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32767
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10000
                    }
                  },
                  "required": [
                    "kind",
                    "x1",
                    "y1",
                    "x2",
                    "y2",
                    "duration_ms"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "keyevent"
                    },
                    "key_code": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "long_press": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "kind",
                    "key_code"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "text"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024,
                      "pattern": "^[ -~]+$"
                    },
                    "enter": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                }
              ]
            }
          },
          "required": [
            "device_id",
            "action"
          ]
        }
      },
      "target": {
        "kind": "device_capability",
        "plugin_id": "android-device",
        "capability": "input",
        "version": 1
      },
      "input": "device_envelope",
      "result": {
        "kind": "value",
        "wrapped": true
      }
    }
  ]
}

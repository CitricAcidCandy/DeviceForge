  "operations": [
    {
      "name": "performance.sample",
      "title": "读取Android主进程计数、游戏帧与设备环境",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^-]",
            "not": {
              "anyOf": [
                {
                  "pattern": "^\\s*$"
                },
                {
                  "pattern": "[\\u0000-\\u001F\\u007F-\\u009F]"
                }
              ]
            },
            "description": "保留原文；运行时另校最多200个UTF-8字节"
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package": {
                "type": "string",
                "minLength": 3,
                "maxLength": 200,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$"
              }
            },
            "required": [
              "package"
            ]
          }
        },
        "required": [
          "device_id",
          "input"
        ]
      }
    },
    {
      "name": "app.install_apks",
      "title": "匹配指定设备并安装APKS",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^-]",
            "not": {

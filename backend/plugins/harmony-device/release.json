{
  "format_version": 2,
  "host_api_version": 2,
  "id": "harmony-device",
  "version": "0.1.0",
  "name": "Harmony 设备",
  "description": "提供鸿蒙设备发现与连接、应用安装和管理、截图及输入。通过本机发现、共享复用或声明的官方来源自动准备和绑定 HDC；用户选择目标设备并配置传输限额等业务选项，实际能力取决于设备与授权状态。",
  "components": [
    {
      "id": "harmony-device",
      "kind": "server",
      "version": "0.1.0",
      "variants": []
    }
  ],
  "tools": [],
  "dependencies": {
    "format_version": 1,
    "dependencies": [
      {
        "id": "hdc",
        "entries": [
          "hdc",
          "libusb"
        ],
        "discovery": [
          {
            "kind": "environment",
            "value": "HDC_PATH",
            "entries": {
              "hdc": ".",
              "libusb": "libusb_shared.dll"
            }
          },
          {
            "kind": "environment",
            "value": "APK_HDC",
            "entries": {
              "hdc": ".",
              "libusb": "libusb_shared.dll"
            }
          },
          {
            "kind": "path",
            "value": "hdc.exe",
            "entries": {
              "hdc": ".",
              "libusb": "libusb_shared.dll"
            }
          },
          {
            "kind": "user_directory",
            "value": "tools/hdc",
            "entries": {
              "hdc": "hdc.exe",
              "libusb": "libusb_shared.dll"
            }
          }
        ],
        "name": "鸿蒙设备连接器",
        "probe": {
          "entry": "hdc",
          "args": [
            "-v"
          ],
          "pattern": "([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)",
          "timeout_ms": 3000
        },
        "version_requirement": "=5.0.0.71",
        "required": true,
        "requires": [],
        "sources": [],
        "bindings": [
          {
            "component_id": "harmony-device",
            "config_pointer": "/tools/hdc",
            "entry": "hdc"
          }
        ]
      }
    ]
  },
  "requirements": []
}

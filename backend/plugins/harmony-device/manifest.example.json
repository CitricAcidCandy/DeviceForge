{
  "id": "harmony-device",
  "version": "0.1.0",
  "protocol_version": 4,
  "args": [],
  "artifacts": {"input_fields": [], "input_pointers": ["/input/artifact_id"], "outputs": true},
  "devices": {
    "api_version": 3,

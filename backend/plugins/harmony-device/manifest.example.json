      {"id":"packages","version":1,"operation":"packages","scope":"device","access":"read","execution_timeout_ms":30000},
      {"id":"connect","version":1,"operation":"connect","scope":"provider","access":"write","execution_timeout_ms":30000},
      {"id":"disconnect","version":1,"operation":"disconnect","scope":"provider","access":"write","execution_timeout_ms":30000},
      {"id":"app.install","version":1,"operation":"app.install","scope":"device","access":"write","execution_timeout_ms":120000},
      {"id":"app.uninstall","version":1,"operation":"app.uninstall","scope":"device","access":"write","execution_timeout_ms":120000},
      {"id":"app.detail","version":1,"operation":"app.detail","scope":"device","access":"read","execution_timeout_ms":30000},
      {"id":"app.start","version":1,"operation":"app.start","scope":"device","access":"write","execution_timeout_ms":30000},
      {"id":"app.stop","version":1,"operation":"app.stop","scope":"device","access":"write","execution_timeout_ms":30000},

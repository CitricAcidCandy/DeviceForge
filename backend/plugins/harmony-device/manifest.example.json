      {"id":"screenshot","version":1,"operation":"screenshot","scope":"device","access":"write","execution_timeout_ms":30000}
    ]
  },
  "operations": [
    {"name":"input","title":"发送Harmony设备输入","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"action":{"oneOf":[{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"tap"},"x":{"type":"integer","minimum":1,"maximum":32767},"y":{"type":"integer","minimum":1,"maximum":32767}},"required":["kind","x","y"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"swipe"},"x1":{"type":"integer","minimum":1,"maximum":32767},"y1":{"type":"integer","minimum":1,"maximum":32767},"x2":{"type":"integer","minimum":1,"maximum":32767},"y2":{"type":"integer","minimum":1,"maximum":32767},"velocity_pps":{"type":"integer","minimum":200,"maximum":40000}},"required":["kind","x1","y1","x2","y2"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"keyevent"},"key_code":{"type":"integer","minimum":1}},"required":["kind","key_code"]},{"type":"object","additionalProperties":false,"properties":{"kind":{"const":"text"},"x":{"type":"integer","minimum":1,"maximum":32767},"y":{"type":"integer","minimum":1,"maximum":32767},"text":{"type":"string","minLength":1,"maxLength":1024},"enter":{"type":"boolean"}},"required":["kind","x","y","text"]}]}},"required":["action"]}},"required":["device_id","input"]}},
    {"name":"discover","title":"发现Harmony设备","input_schema":{"type":"object","additionalProperties":false,"properties":{},"required":[]}},
    {"name":"packages","title":"枚举Harmony应用","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{},"required":[]}},"required":["device_id","input"]}},
    {"name":"connect","title":"连接Harmony设备","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"null"},"input":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","minLength":9,"maxLength":21,"pattern":"^(?:[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|localhost):[0-9]{1,5}$"}},"required":["address"]}},"required":["device_id","input"]}},
    {"name":"disconnect","title":"断开Harmony设备连接","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"null"},"input":{"type":"object","additionalProperties":false,"properties":{"address":{"type":"string","minLength":9,"maxLength":21,"pattern":"^(?:[0-9]{1,3}(?:\\.[0-9]{1,3}){3}|localhost):[0-9]{1,5}$"}},"required":["address"]}},"required":["device_id","input"]}},
    {"name":"app.install","title":"安装Harmony HAP","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"artifact_id":{"type":"string","minLength":36,"maxLength":36,"pattern":"^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"}},"required":["artifact_id"]}},"required":["device_id","input"]}},
    {"name":"app.uninstall","title":"卸载Harmony应用","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"package":{"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"}},"required":["package"]}},"required":["device_id","input"]}},
    {"name":"app.detail","title":"查询Harmony应用详情","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"bundle":{"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"}},"required":["bundle"]}},"required":["device_id","input"]}},
    {"name":"app.start","title":"启动Harmony应用","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"bundle":{"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"},"ability":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$"}},"required":["bundle"]}},"required":["device_id","input"]}},
    {"name":"app.stop","title":"停止Harmony应用","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"bundle":{"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"}},"required":["bundle"]}},"required":["device_id","input"]}},
    {"name":"app.reset","title":"重置Harmony应用数据","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{"bundle":{"type":"string","maxLength":200,"pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$"}},"required":["bundle"]}},"required":["device_id","input"]}},
    {"name":"screenshot","title":"保存Harmony截图","input_schema":{"type":"object","additionalProperties":false,"properties":{"device_id":{"type":"string","minLength":1,"maxLength":200,"pattern":"^[A-Za-z0-9._:\\[\\]][A-Za-z0-9._:\\[\\]-]*$"},"input":{"type":"object","additionalProperties":false,"properties":{},"required":[]}},"required":["device_id","input"]}}
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "title": "Harmony 设备配置",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "title": "配置格式版本",
          "const": 1,
          "default": 1,
          "readOnly": true
        },
        "tools": {
          "type": "object",
          "title": "本机工具",
          "additionalProperties": false,
          "properties": {
            "hdc": {
              "type": [
                "string",
                "null"
              ],
              "title": "HDC 入口",
              "description": "填写单一程序名或本机绝对路径，不接受命令行拼接。",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "scratch_root": {
          "type": [
            "string",
            "null"
          ],
          "title": "临时目录",
          "description": "本机绝对目录；自动化和 Frida 要求目录已存在。",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "format_version"
      ]
    },
    "defaults": {
      "format_version": 1,
      "tools": {
        "hdc": "hdc"
      }
    },
    "apply_policy": "next_invocation",
    "legacy_filename": "harmony-device.config.json"
  }

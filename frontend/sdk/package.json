{
  "name": "@deviceforge/plugin-sdk",
  "version": "0.1.0",
  "description": "DeviceForge 浏览器插件公开 SDK v2：独立声明与轻量 ESM 辅助函数",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./json": { "types": "./lib/json.d.ts", "default": "./lib/json.js" },
    "./models": { "types": "./lib/models.d.ts", "default": "./lib/models.js" },
    "./points": { "types": "./lib/points.d.ts", "default": "./lib/points.js" },
    "./workspace": { "types": "./lib/workspace.d.ts", "default": "./lib/workspace.js" },
    "./transport": { "types": "./lib/transport.d.ts", "default": "./lib/transport.js" },
    "./data-sources": { "types": "./lib/data-sources.d.ts", "default": "./lib/data-sources.js" },
    "./ui": { "types": "./lib/ui.d.ts", "default": "./lib/ui.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "README.md", "build.json"],
  "peerDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1"
  },
  "engines": { "node": ">=22.18.0" }
}

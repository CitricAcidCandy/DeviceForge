{
  "name": "deviceforge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api": "node scripts/generate-api.ts",
    "check:architecture": "node scripts/check-architecture.ts",
    "check": "npm run check:architecture && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "node scripts/run-tests.ts",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.0.0",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.0",
    "vite": "^8.3.3"
  }
}

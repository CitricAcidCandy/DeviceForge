{
  "name": "@deviceforge/device-apps",
  "description": "独立设备应用与安装包分析视图",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },

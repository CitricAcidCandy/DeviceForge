      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    }
  },
  "dependencies": {
    "@deviceforge/business-kit": "file:../business-kit",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-fit": "0.11.0",
    "radix-ui": "1.8.1",
    "lucide-react": "1.56.0"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@deviceforge/plugin-sdk": "file:../../sdk/dist/deviceforge-plugin-sdk-0.1.0.tgz",
    "@deviceforge/contracts": "file:../../contracts"
  }
}

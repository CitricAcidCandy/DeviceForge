{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@deviceforge/plugin-sdk": ["../src/plugin-sdk/index.ts"],
      "@deviceforge/business-kit/api": ["../plugins/business-kit/src/api/index.ts"],

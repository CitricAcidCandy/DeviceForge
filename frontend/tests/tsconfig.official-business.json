      "@deviceforge/business-kit/dialog": ["../plugins/business-kit/src/react/dialog.tsx"],
      "@deviceforge/business-kit/platform": ["../plugins/business-kit/src/platform.ts"],
      "@deviceforge/business-kit/workspace": ["../plugins/business-kit/src/workspace.ts"],
      "@deviceforge/business-kit/device": ["../plugins/business-kit/src/device.ts"],

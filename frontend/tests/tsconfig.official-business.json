    "../plugins/performance/src/**/*.ts",
    "../plugins/performance/src/**/*.tsx",
    "./official-business-*.ts",
    "./frida-consumption.test.ts",
    "./automation-consumption.test.ts",
    "./automation-desktop-consumption.test.ts",
    "./automation-legacy-mouse.test.ts",
